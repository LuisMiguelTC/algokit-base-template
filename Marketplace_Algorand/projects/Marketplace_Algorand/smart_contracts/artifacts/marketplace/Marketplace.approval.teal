    app_global_put
    // smart_contracts/marketplace/contract.py:28-30
    // # Metodo che crea l'applicazione e configura i parametri globali:
    // # Fee del 1% e contatore listing.
    // @arc4.abimethod(allow_actions=["NoOp"], create="require")
    intc_0 // 1
    return


// smart_contracts.marketplace.contract.Marketplace.list_asset[routing]() -> void:
