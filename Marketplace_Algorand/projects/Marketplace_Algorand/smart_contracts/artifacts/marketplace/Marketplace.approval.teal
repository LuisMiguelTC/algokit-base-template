    app_global_put
    // smart_contracts/marketplace/contract.py:33
    // self.BPS_DIVISOR = UInt64(10_000)   # Divisore.
    bytec_2 // "BPS_DIVISOR"
    pushint 10000
    app_global_put
    // smart_contracts/marketplace/contract.py:34
    // self.active_listings = UInt64(0)    # Contatore listing.
    bytec_0 // "active_listings"
