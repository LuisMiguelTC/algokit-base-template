#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 1 0 8 4
    bytecblock "active_listings" "FEE_BPS" "BPS_DIVISOR"
    // smart_contracts/marketplace/contract.py:15-16
    // # Definizione della classe Marketplace.
    // class Marketplace(ARC4Contract):
    pushbytes 0x33b3499e // method "delete_application()void"
    txna ApplicationArgs 0
    match main_delete_application_route@4

main_switch_case_next@5:
    // smart_contracts/marketplace/contract.py:15-16
    // # Definizione della classe Marketplace.
    // class Marketplace(ARC4Contract):
    txn OnCompletion
    !
    assert
    txn ApplicationID
    bz main_create_NoOp@12
    pushbytess 0x23411257 0xfc7ea22e 0xdbdb0785 0xa1248514 // method "list_asset(uint64,uint64,pay)void", method "deposit_asset(axfer)uint64", method "buy_asset(uint64,uint64,pay)void", method "delist_remaining_assets(uint64)void"
    txna ApplicationArgs 0
    match list_asset deposit_asset buy_asset delist_remaining_assets
    err

main_create_NoOp@12:
    // smart_contracts/marketplace/contract.py:15-16
    // # Definizione della classe Marketplace.
    // class Marketplace(ARC4Contract):
    pushbytes 0x752c3ac0 // method "create_application()void"
    txna ApplicationArgs 0
    match create_application
    err

main_delete_application_route@4:
    // smart_contracts/marketplace/contract.py:165-166
    // # Metodo che termina e chiude il marketplace.
    // @arc4.abimethod(allow_actions=["DeleteApplication"])
    txn OnCompletion
    pushint 5 // DeleteApplication
    ==
    txn ApplicationID
    &&
    assert
    b delete_application


// smart_contracts.marketplace.contract.Marketplace.create_application[routing]() -> void:
